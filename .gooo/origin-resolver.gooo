{
  "schema": "gooo.origin-resolver/v2",
  "authority": "metacode",
  "contract_id": "gooo-hygienic-origin-resolver-staged-quasiquote",
  "toolchain": {"go": "1.27"},
  "semantics": {
    "identity": {
      "algorithm": "sha256",
      "inputs": ["declaration_origin", "expansion_origin", "symbol_id"],
      "delimiter": "|",
      "prefix": "sym_"
    },
    "alpha_renaming": {"fresh_policy": "fresh", "separator": "__gooo_", "identity_chars": 16},
    "fixed_point": "FIXED_POINT",
    "capture_judgment": {
      "fresh_collision": "ALPHA_RENAME",
      "intended_target": "INTENDED_CAPTURE",
      "no_collision": "CAPTURE_FREE",
      "unintended_target": "UNINTENDED_CAPTURE",
      "missing_origin": "UNKNOWN",
      "missing_stage": "UNKNOWN",
      "missing_grant": "UNKNOWN",
      "forged_grant": "FORGED_CAPTURE_GRANT"
    },
    "status_precedence": ["REFUTED", "UNKNOWN", "CLOSED"],
    "unknown": {
      "stage": "resolve",
      "step": "prove-origin-stage-capability",
      "reason": "a required origin, stage, or capture capability is not sufficiently evidenced",
      "unknown_class": "incomplete-proof",
      "next_operation": "supply the missing evidence and replay the same case",
      "blocked_by": "incomplete-origin-stage-capability-proof"
    },
    "denominator": {
      "cells": [
        {"id": "cell.declaration", "meta_activity": "declaration", "proof_lane": "FOUNDATION", "indicator_lane": "DRIVER"},
        {"id": "cell.parser", "meta_activity": "parser", "proof_lane": "FOUNDATION", "indicator_lane": "DRIVER"},
        {"id": "cell.stage-expansion", "meta_activity": "stage-expansion", "proof_lane": "FOUNDATION", "indicator_lane": "DRIVER"},
        {"id": "cell.scope-resolution", "meta_activity": "scope-resolution", "proof_lane": "FOUNDATION", "indicator_lane": "OUTCOME"},
        {"id": "cell.splice-order", "meta_activity": "splice-order", "proof_lane": "COHERENCE", "indicator_lane": "DRIVER"},
        {"id": "cell.alpha-renaming", "meta_activity": "alpha-renaming", "proof_lane": "COHERENCE", "indicator_lane": "OUTCOME"},
        {"id": "cell.origin-stack", "meta_activity": "origin-stack", "proof_lane": "COHERENCE", "indicator_lane": "OUTCOME"},
        {"id": "cell.capture-grant", "meta_activity": "capture-grant", "proof_lane": "COHERENCE", "indicator_lane": "OUTCOME"},
        {"id": "cell.ir-generation", "meta_activity": "ir-generation", "proof_lane": "REGRESSION", "indicator_lane": "GUARDRAIL"},
        {"id": "cell.go-generation", "meta_activity": "go-generation", "proof_lane": "REGRESSION", "indicator_lane": "GUARDRAIL"},
        {"id": "cell.human-report", "meta_activity": "human-report", "proof_lane": "REGRESSION", "indicator_lane": "GUARDRAIL"},
        {"id": "cell.machine-report", "meta_activity": "machine-report", "proof_lane": "REGRESSION", "indicator_lane": "GUARDRAIL"}
      ],
      "meta_activities": ["declaration", "parser", "stage-expansion", "scope-resolution", "splice-order", "alpha-renaming", "origin-stack", "capture-grant", "ir-generation", "go-generation", "human-report", "machine-report"],
      "proof": {
        "FOUNDATION": ["declaration", "parser", "stage-expansion", "scope-resolution"],
        "COHERENCE": ["splice-order", "alpha-renaming", "origin-stack", "capture-grant"],
        "REGRESSION": ["ir-generation", "go-generation", "human-report", "machine-report"]
      },
      "indicators": {
        "DRIVER": ["declaration", "parser", "stage-expansion", "splice-order"],
        "OUTCOME": ["scope-resolution", "alpha-renaming", "origin-stack", "capture-grant"],
        "GUARDRAIL": ["ir-generation", "go-generation", "human-report", "machine-report"]
      },
      "improvement": "same case/source/contract/toolchain digest with a paired integer before/after observation; absent evidence remains UNKNOWN"
    },
    "bounds": {"max_nodes": 256, "max_quote_depth": 8, "max_splices": 16, "max_origin_hops": 16},
    "generation_plan": [
      "parse this .gooo declaration into typed syntax nodes",
      "expand nested quasiquote and splice nodes at explicit stages",
      "compute stable identity from declaration origin, expansion origin, and symbol id",
      "alpha-rename only fresh binders with visible collisions in deterministic identity order",
      "authorize caller capture only through a valid origin-backed capture capability",
      "emit a structured IR and generated Go without arbitrary string replacement",
      "write human-readable and machine-readable evidence with REFUTED > UNKNOWN > CLOSED"
    ],
    "no_arbitrary_string_replacement": true,
    "no_aggregate_scores_or_percentages": true
  },
  "declaration_origins": [
    {"id": "origin.user.x", "source": "fixtures/caller.go", "line": 1, "column": 1, "label": "caller declaration x"},
    {"id": "origin.outer.x", "source": "fixtures/macro.gooo", "line": 10, "column": 5, "label": "outer staged binder x"},
    {"id": "origin.inner.x", "source": "fixtures/macro.gooo", "line": 20, "column": 5, "label": "inner staged binder x"},
    {"id": "origin.left.x", "source": "fixtures/macro.gooo", "line": 30, "column": 5, "label": "left splice binder x"},
    {"id": "origin.right.x", "source": "fixtures/macro.gooo", "line": 31, "column": 5, "label": "right splice binder x"},
    {"id": "origin.shadow.outer.x", "source": "fixtures/macro.gooo", "line": 40, "column": 5, "label": "shadowed outer binder x"},
    {"id": "origin.shadow.inner.x", "source": "fixtures/macro.gooo", "line": 41, "column": 5, "label": "shadowed inner binder x"},
    {"id": "origin.sibling.left.x", "source": "fixtures/macro.gooo", "line": 50, "column": 5, "label": "sibling left binder x"},
    {"id": "origin.sibling.right.x", "source": "fixtures/macro.gooo", "line": 51, "column": 5, "label": "sibling right binder x"},
    {"id": "origin.grant.tmp", "source": "fixtures/macro.gooo", "line": 60, "column": 5, "label": "capture helper binder"},
    {"id": "origin.ambiguous.x", "source": "fixtures/macro.gooo", "line": 70, "column": 5, "label": "ambiguous stage binder"},
    {"id": "origin.forged.tmp", "source": "fixtures/macro.gooo", "line": 80, "column": 5, "label": "forged grant helper"},
    {"id": "origin.fixed.x", "source": "fixtures/macro.gooo", "line": 90, "column": 5, "label": "fixed binder counterexample"}
  ],
  "reference_origins": [
    {"id": "origin.ref.outer.x", "source": "fixtures/macro.gooo", "line": 11, "column": 12, "label": "outer binder reference"},
    {"id": "origin.ref.inner.x", "source": "fixtures/macro.gooo", "line": 21, "column": 12, "label": "inner binder reference"},
    {"id": "origin.ref.left.x", "source": "fixtures/macro.gooo", "line": 32, "column": 12, "label": "left splice reference"},
    {"id": "origin.ref.right.x", "source": "fixtures/macro.gooo", "line": 33, "column": 12, "label": "right splice reference"},
    {"id": "origin.ref.shadow.inner.x", "source": "fixtures/macro.gooo", "line": 42, "column": 12, "label": "shadowed inner reference"},
    {"id": "origin.ref.sibling.left.x", "source": "fixtures/macro.gooo", "line": 52, "column": 12, "label": "sibling left reference"},
    {"id": "origin.ref.sibling.right.x", "source": "fixtures/macro.gooo", "line": 53, "column": 12, "label": "sibling right reference"},
    {"id": "origin.ref.grant.x", "source": "fixtures/macro.gooo", "line": 61, "column": 12, "label": "explicit caller reference"},
    {"id": "origin.ref.missing.grant", "source": "fixtures/macro.gooo", "line": 62, "column": 12, "label": "caller reference without grant"},
    {"id": "origin.ref.forged.x", "source": "fixtures/macro.gooo", "line": 81, "column": 12, "label": "forged grant reference"},
    {"id": "origin.ref.implicit.x", "source": "fixtures/macro.gooo", "line": 82, "column": 12, "label": "implicit caller reference"},
    {"id": "origin.ref.fixed.x", "source": "fixtures/macro.gooo", "line": 91, "column": 12, "label": "fixed binder capture reference"}
  ],
  "expansion_origins": [
    {"id": "exp.source", "macro": "caller", "call_site": "fixtures/caller.go:1:1", "parent": "", "stage": 0},
    {"id": "exp.outer", "macro": "outer", "call_site": "fixtures/caller.go:2:1", "parent": "exp.source", "stage": 1},
    {"id": "exp.inner", "macro": "inner", "call_site": "fixtures/macro.gooo:20:1", "parent": "exp.outer", "stage": 2},
    {"id": "exp.splices", "macro": "two-splices", "call_site": "fixtures/caller.go:3:1", "parent": "exp.source", "stage": 1},
    {"id": "exp.left", "macro": "left", "call_site": "fixtures/macro.gooo:30:1", "parent": "exp.splices", "stage": 1},
    {"id": "exp.right", "macro": "right", "call_site": "fixtures/macro.gooo:31:1", "parent": "exp.splices", "stage": 1},
    {"id": "exp.shadow", "macro": "shadow", "call_site": "fixtures/caller.go:4:1", "parent": "exp.source", "stage": 1},
    {"id": "exp.shadow.inner", "macro": "shadow-inner", "call_site": "fixtures/macro.gooo:41:1", "parent": "exp.shadow", "stage": 2},
    {"id": "exp.sibling", "macro": "siblings", "call_site": "fixtures/caller.go:5:1", "parent": "exp.source", "stage": 1},
    {"id": "exp.grant", "macro": "capture-grant", "call_site": "fixtures/caller.go:6:1", "parent": "exp.source", "stage": 1},
    {"id": "exp.stage", "macro": "ambiguous-stage", "call_site": "fixtures/caller.go:7:1", "parent": "exp.source", "stage": 1},
    {"id": "exp.forged", "macro": "forged-grant", "call_site": "fixtures/caller.go:8:1", "parent": "exp.source", "stage": 1},
    {"id": "exp.implicit", "macro": "implicit-capture", "call_site": "fixtures/caller.go:9:1", "parent": "exp.source", "stage": 1},
    {"id": "exp.fixed", "macro": "fixed-capture", "call_site": "fixtures/caller.go:10:1", "parent": "exp.source", "stage": 1}
  ],
  "scope_edges": [
    {"child": "outer", "parent": "root", "kind": "expansion"},
    {"child": "inner", "parent": "outer", "kind": "nested-expansion"},
    {"child": "splices", "parent": "root", "kind": "expansion"},
    {"child": "left", "parent": "splices", "kind": "splice"},
    {"child": "right", "parent": "splices", "kind": "splice"},
    {"child": "shadow", "parent": "root", "kind": "expansion"},
    {"child": "shadow-inner", "parent": "shadow", "kind": "nested-expansion"},
    {"child": "sibling", "parent": "root", "kind": "expansion"},
    {"child": "grant", "parent": "root", "kind": "expansion"},
    {"child": "ambiguous", "parent": "root", "kind": "expansion"},
    {"child": "missing", "parent": "root", "kind": "expansion"},
    {"child": "forged", "parent": "root", "kind": "expansion"},
    {"child": "implicit", "parent": "root", "kind": "expansion"},
    {"child": "fixed", "parent": "root", "kind": "expansion"}
  ],
  "declared_symbols": [
    {"id": "user.x", "spelling": "x", "kind": "caller-binder", "declaration_origin": "origin.user.x", "expansion_origin": "exp.source", "scope": "root", "capture_policy": "existing", "stage": 0}
  ],
  "introduced_symbols": [
    {"id": "outer.x", "spelling": "x", "kind": "introduced-binder", "declaration_origin": "origin.outer.x", "expansion_origin": "exp.outer", "scope": "outer", "capture_policy": "fresh", "stage": 1},
    {"id": "inner.x", "spelling": "x", "kind": "introduced-binder", "declaration_origin": "origin.inner.x", "expansion_origin": "exp.inner", "scope": "inner", "capture_policy": "fresh", "stage": 2},
    {"id": "left.x", "spelling": "x", "kind": "introduced-binder", "declaration_origin": "origin.left.x", "expansion_origin": "exp.left", "scope": "splices", "capture_policy": "fresh", "stage": 1},
    {"id": "right.x", "spelling": "x", "kind": "introduced-binder", "declaration_origin": "origin.right.x", "expansion_origin": "exp.right", "scope": "splices", "capture_policy": "fresh", "stage": 1},
    {"id": "shadow.outer.x", "spelling": "x", "kind": "introduced-binder", "declaration_origin": "origin.shadow.outer.x", "expansion_origin": "exp.shadow", "scope": "shadow", "capture_policy": "fresh", "stage": 1},
    {"id": "shadow.inner.x", "spelling": "x", "kind": "introduced-binder", "declaration_origin": "origin.shadow.inner.x", "expansion_origin": "exp.shadow.inner", "scope": "shadow-inner", "capture_policy": "fresh", "stage": 2},
    {"id": "sibling.left.x", "spelling": "x", "kind": "introduced-binder", "declaration_origin": "origin.sibling.left.x", "expansion_origin": "exp.sibling", "scope": "sibling", "capture_policy": "fresh", "stage": 1},
    {"id": "sibling.right.x", "spelling": "x", "kind": "introduced-binder", "declaration_origin": "origin.sibling.right.x", "expansion_origin": "exp.sibling", "scope": "sibling", "capture_policy": "fresh", "stage": 1},
    {"id": "grant.tmp", "spelling": "tmp", "kind": "introduced-binder", "declaration_origin": "origin.grant.tmp", "expansion_origin": "exp.grant", "scope": "grant", "capture_policy": "fresh", "stage": 1},
    {"id": "ambiguous.x", "spelling": "x", "kind": "introduced-binder", "declaration_origin": "origin.ambiguous.x", "expansion_origin": "exp.stage", "scope": "ambiguous", "capture_policy": "fresh", "stage": 1},
    {"id": "missing.origin", "spelling": "broken", "kind": "introduced-binder", "declaration_origin": "", "expansion_origin": "exp.stage", "scope": "missing", "capture_policy": "fresh", "stage": 1},
    {"id": "forged.tmp", "spelling": "tmp", "kind": "introduced-binder", "declaration_origin": "origin.forged.tmp", "expansion_origin": "exp.forged", "scope": "forged", "capture_policy": "fresh", "stage": 1},
    {"id": "fixed.x", "spelling": "x", "kind": "introduced-binder", "declaration_origin": "origin.fixed.x", "expansion_origin": "exp.fixed", "scope": "fixed", "capture_policy": "fixed", "stage": 1}
  ],
  "reference_symbols": [
    {"id": "outer.ref", "spelling": "x", "reference_origin": "origin.ref.outer.x", "expansion_origin": "exp.outer", "scope": "outer", "target_symbol": "outer.x", "capture_policy": "fresh", "stage": 1},
    {"id": "inner.ref", "spelling": "x", "reference_origin": "origin.ref.inner.x", "expansion_origin": "exp.inner", "scope": "inner", "target_symbol": "inner.x", "capture_policy": "fresh", "stage": 2},
    {"id": "left.ref", "spelling": "x", "reference_origin": "origin.ref.left.x", "expansion_origin": "exp.left", "scope": "splices", "target_symbol": "left.x", "capture_policy": "fresh", "stage": 1},
    {"id": "right.ref", "spelling": "x", "reference_origin": "origin.ref.right.x", "expansion_origin": "exp.right", "scope": "splices", "target_symbol": "right.x", "capture_policy": "fresh", "stage": 1},
    {"id": "shadow.inner.ref", "spelling": "x", "reference_origin": "origin.ref.shadow.inner.x", "expansion_origin": "exp.shadow.inner", "scope": "shadow-inner", "target_symbol": "shadow.inner.x", "capture_policy": "fresh", "stage": 2},
    {"id": "sibling.left.ref", "spelling": "x", "reference_origin": "origin.ref.sibling.left.x", "expansion_origin": "exp.sibling", "scope": "sibling", "target_symbol": "sibling.left.x", "capture_policy": "fresh", "stage": 1},
    {"id": "sibling.right.ref", "spelling": "x", "reference_origin": "origin.ref.sibling.right.x", "expansion_origin": "exp.sibling", "scope": "sibling", "target_symbol": "sibling.right.x", "capture_policy": "fresh", "stage": 1},
    {"id": "grant.ref", "spelling": "x", "reference_origin": "origin.ref.grant.x", "expansion_origin": "exp.grant", "scope": "grant", "target_symbol": "user.x", "capture_policy": "intentional", "capture_grant": "grant.valid", "stage": 1},
    {"id": "missing.grant.ref", "spelling": "x", "reference_origin": "origin.ref.missing.grant", "expansion_origin": "exp.grant", "scope": "grant", "target_symbol": "user.x", "capture_policy": "intentional", "stage": 1},
    {"id": "missing.ref", "spelling": "broken", "reference_origin": "", "expansion_origin": "exp.stage", "scope": "missing", "target_symbol": "missing.origin", "capture_policy": "fresh", "stage": 1},
    {"id": "forged.ref", "spelling": "x", "reference_origin": "origin.ref.forged.x", "expansion_origin": "exp.forged", "scope": "forged", "target_symbol": "user.x", "capture_policy": "intentional", "capture_grant": "grant.forged", "stage": 1},
    {"id": "implicit.ref", "spelling": "x", "reference_origin": "origin.ref.implicit.x", "expansion_origin": "exp.implicit", "scope": "implicit", "target_symbol": "user.x", "capture_policy": "implicit", "stage": 1},
    {"id": "fixed.ref", "spelling": "x", "reference_origin": "origin.ref.fixed.x", "expansion_origin": "exp.fixed", "scope": "fixed", "target_symbol": "user.x", "capture_policy": "forbid", "stage": 1}
  ],
  "capture_grants": [
    {"id": "grant.valid", "reference_symbol": "grant.ref", "target_symbol": "user.x", "expansion_origin": "exp.grant", "stage": 1, "capability": "capture", "evidence": "origin-stack"},
    {"id": "grant.forged", "reference_symbol": "grant.ref", "target_symbol": "user.x", "expansion_origin": "exp.forged", "stage": 1, "capability": "capture", "evidence": "origin-stack"}
  ],
  "cases": [
    {
      "id": "nested-quasiquote", "description": "nested quasiquote and a nested splice preserve stage while the shadowed outer and inner x binders are renamed", "root_scope": "root", "declared_symbols": ["user.x"], "introduced_symbols": ["outer.x", "inner.x"], "reference_symbols": ["outer.ref", "inner.ref"], "expected_status": "CLOSED",
      "form": {"kind": "quasiquote", "stage": 0, "origin": "syntax.nested.root", "expansion_origin": "exp.source", "children": [
        {"kind": "binder", "stage": 1, "origin": "origin.outer.x", "symbol": "outer.x"},
        {"kind": "reference", "stage": 1, "origin": "origin.ref.outer.x", "reference": "outer.ref"},
        {"kind": "quasiquote", "stage": 1, "origin": "syntax.nested.inner", "expansion_origin": "exp.outer", "children": [
          {"kind": "splice", "stage": 2, "origin": "syntax.nested.splice", "expansion_origin": "exp.inner", "children": [
            {"kind": "binder", "stage": 2, "origin": "origin.inner.x", "symbol": "inner.x"},
            {"kind": "reference", "stage": 2, "origin": "origin.ref.inner.x", "reference": "inner.ref"}
          ]}
        ]}
      ]},
      "example": {"package": "main", "function": "CaptureFree", "bindings": [{"symbol": "outer.x", "value": "outer"}, {"symbol": "inner.x", "value": "inner"}], "return_reference": "inner.ref"}
    },
    {
      "id": "two-splices", "description": "two ordered splices expand in source order and same-scope sibling binders receive distinct names", "root_scope": "root", "declared_symbols": ["user.x"], "introduced_symbols": ["left.x", "right.x"], "reference_symbols": ["left.ref", "right.ref"], "expected_status": "CLOSED",
      "form": {"kind": "quasiquote", "stage": 0, "origin": "syntax.two-splices.root", "expansion_origin": "exp.source", "children": [
        {"kind": "splice", "stage": 1, "origin": "syntax.left.splice", "expansion_origin": "exp.left", "children": [{"kind": "binder", "stage": 1, "origin": "origin.left.x", "symbol": "left.x"}, {"kind": "reference", "stage": 1, "origin": "origin.ref.left.x", "reference": "left.ref"}]},
        {"kind": "splice", "stage": 1, "origin": "syntax.right.splice", "expansion_origin": "exp.right", "children": [{"kind": "binder", "stage": 1, "origin": "origin.right.x", "symbol": "right.x"}, {"kind": "reference", "stage": 1, "origin": "origin.ref.right.x", "reference": "right.ref"}]}
      ]}
    },
    {
      "id": "capture-free-base", "description": "a quoted literal with a complete source origin is a bounded capture-free base", "root_scope": "root", "declared_symbols": ["user.x"], "introduced_symbols": [], "reference_symbols": [], "expected_status": "CLOSED",
      "form": {"kind": "quasiquote", "stage": 0, "origin": "syntax.base.root", "expansion_origin": "exp.source", "children": [{"kind": "literal", "stage": 1, "origin": "syntax.base.literal", "value": "base"}]}
    },
    {
      "id": "explicit-intentional-capture", "description": "caller capture is closed only with an exact origin-backed capability grant", "root_scope": "root", "declared_symbols": ["user.x"], "introduced_symbols": ["grant.tmp"], "reference_symbols": ["grant.ref"], "expected_status": "CLOSED",
      "form": {"kind": "quasiquote", "stage": 0, "origin": "syntax.grant.root", "expansion_origin": "exp.source", "children": [{"kind": "binder", "stage": 1, "origin": "origin.grant.tmp", "symbol": "grant.tmp"}, {"kind": "reference", "stage": 1, "origin": "origin.ref.grant.x", "reference": "grant.ref"}]}
    },
    {
      "id": "missing-origin", "description": "missing declaration and reference origins remain UNKNOWN with six fields", "root_scope": "root", "declared_symbols": ["user.x"], "introduced_symbols": ["missing.origin"], "reference_symbols": ["missing.ref"], "expected_status": "UNKNOWN",
      "form": {"kind": "quasiquote", "stage": 0, "origin": "syntax.missing.origin", "expansion_origin": "exp.source", "children": [{"kind": "binder", "stage": 1, "symbol": "missing.origin"}, {"kind": "reference", "stage": 1, "reference": "missing.ref"}]}
    },
    {
      "id": "ambiguous-stage", "description": "a splice stage that disagrees with nested expansion depth is UNKNOWN", "root_scope": "root", "declared_symbols": ["user.x"], "introduced_symbols": ["ambiguous.x"], "reference_symbols": [], "expected_status": "UNKNOWN",
      "form": {"kind": "quasiquote", "stage": 0, "origin": "syntax.ambiguous.root", "expansion_origin": "exp.source", "children": [{"kind": "quasiquote", "stage": 1, "origin": "syntax.ambiguous.inner", "expansion_origin": "exp.stage", "children": [{"kind": "splice", "stage": 1, "origin": "syntax.ambiguous.splice", "expansion_origin": "exp.stage", "children": [{"kind": "binder", "stage": 1, "origin": "origin.ambiguous.x", "symbol": "ambiguous.x"}]}]}]}
    },
    {
      "id": "missing-grant", "description": "an intentional caller target without a declared capability grant is UNKNOWN", "root_scope": "root", "declared_symbols": ["user.x"], "introduced_symbols": [], "reference_symbols": ["missing.grant.ref"], "expected_status": "UNKNOWN",
      "form": {"kind": "quasiquote", "stage": 0, "origin": "syntax.missing.grant", "expansion_origin": "exp.source", "children": [{"kind": "reference", "stage": 1, "origin": "origin.ref.missing.grant", "reference": "missing.grant.ref"}]}
    },
    {
      "id": "missing-expansion-origin", "description": "a form without an expansion origin cannot close its origin stack", "root_scope": "root", "declared_symbols": ["user.x"], "introduced_symbols": [], "reference_symbols": [], "expected_status": "UNKNOWN",
      "form": {"kind": "quasiquote", "stage": 0, "origin": "syntax.missing.expansion"}
    },
    {
      "id": "forged-capture-grant", "description": "a grant whose reference identity does not match the use is REFUTED", "root_scope": "root", "declared_symbols": ["user.x"], "introduced_symbols": ["forged.tmp"], "reference_symbols": ["forged.ref"], "expected_status": "REFUTED",
      "form": {"kind": "quasiquote", "stage": 0, "origin": "syntax.forged.root", "expansion_origin": "exp.source", "children": [{"kind": "binder", "stage": 1, "origin": "origin.forged.tmp", "symbol": "forged.tmp"}, {"kind": "reference", "stage": 1, "origin": "origin.ref.forged.x", "reference": "forged.ref"}]}
    },
